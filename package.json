{
  "name": "beyond-chatbot",
  "version": "0.1.0",
  "description": "Knowledge map of atomic AI/statistical-AI concepts with typed edges",
  "type": "commonjs",
  "main": "dist/data/graph.json",
  "engines": {
    "node": ">=14.15.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "test": "mocha test/**/*.test.js",
    "test:schema": "mocha test/schema.test.js",
    "build": "node scripts/import-yaml.js && node scripts/export-json.js",
    "import": "node scripts/import-yaml.js",
    "export": "node scripts/export-json.js"
  },
  "keywords": [
    "ai",
    "taxonomy",
    "graph",
    "knowledge-map",
    "ladybugdb"
  ],
  "author": "Kresna Sucandra",
  "license": "MIT",
  "devDependencies": {
    "mocha": "^10.2.0"
  },
  "dependencies": {
    "@ladybugdb/core": "^0.16.1"
  }
