{
  "name": "beyond-chatbot",
  "version": "0.1.0",
  "description": "Knowledge map of atomic AI/statistical-AI concepts with typed edges",
  "type": "commonjs",
  "main": "dist/data/graph.json",
  "engines": {
    "node": ">=14.15.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "compile": "tsc",
    "test": "mocha test/**/*.test.js",
    "test:schema": "mocha test/schema.test.js",
    "build": "pnpm compile && node dist/scripts/import-yaml.js && node dist/scripts/export-json.js",
    "import": "pnpm compile && node dist/scripts/import-yaml.js",
    "export": "pnpm compile && node dist/scripts/export-json.js"
  },
  "keywords": [
    "ai",
    "taxonomy",
    "graph",
    "knowledge-map",
    "ladybugdb"
  ],
  "author": "Kresna Sucandra",
  "license": "MIT",
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.9.1",
    "mocha": "^10.2.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@ladybugdb/core": "^0.16.1",
    "js-yaml": "^4.1.0"
  }
}
